#include <windows.h>
#include "resource.h"

// Version macros come from the one place that defines them, so the file version
// stamped into the exe can never drift from DEXPRESENTER_VERSION.
#include "../src/Version.h"

// Application icon
IDI_DEXPRESENTER ICON "DexPresenter.ico"

// Toolbar PNG icons
IDB_TOOLBAR_SNIP  RCDATA "icons/snip.png"
IDB_TOOLBAR_DRAW  RCDATA "icons/draw.png"
IDB_TOOLBAR_TIMER RCDATA "icons/timer.png"
IDB_TOOLBAR_ZOOM  RCDATA "icons/zoom.png"
IDB_TOOLBAR_CLOSE RCDATA "icons/close.png"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     DEXPRESENTER_VERSION_COMMA
PRODUCTVERSION  DEXPRESENTER_VERSION_COMMA
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",       "DexPresenter"
            VALUE "FileDescription",   "DexPresenter Screen Utility"
            VALUE "FileVersion",       DEXPRESENTER_VERSION_DOTTED
            VALUE "InternalName",      "DexPresenter"
            VALUE "LegalCopyright",    "Copyright (C) 2026 Gunter Heiss. Licensed under GPLv3."
            VALUE "OriginalFilename",  "DexPresenter.exe"
            VALUE "ProductName",       "DexPresenter"
            VALUE "ProductVersion",    DEXPRESENTER_VERSION_DOTTED
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
